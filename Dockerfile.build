# ─────────────────────────────────────────────────────────────────────────────
# ToolLogPro – Ubuntu 20.04 BUILD container
#
# Purpose: compile the app and package it as an AppImage inside Ubuntu 20.04
# so the resulting binary only requires GLIBC >= 2.31 (Ubuntu 20.04+).
# Building on your Ubuntu 24.04 host would produce a binary that needs
# GLIBC 2.39 and refuses to start on older systems.
#
# Usage:
#   # One-liner – build image, extract AppImage, remove container:
#   ./deploy/build-appimage.sh
#
#   # Or manually:
#   docker build -f Dockerfile.build -t toollogpro-builder:ubuntu20 .
#   id=$(docker create toollogpro-builder:ubuntu20)
#   docker cp $id:/output/ToolLogPro-x86_64.AppImage deploy/
#   docker rm $id
# ─────────────────────────────────────────────────────────────────────────────
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# ── Step 1: base tools + universe repo ──────────────────────────────────────
# libxcb-renderutil0 is in universe; enable it before the main install.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates gnupg wget curl software-properties-common \
 && add-apt-repository universe \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential gcc-10 g++-10 ninja-build \
        libfuse2 fuse file \
        libgl1-mesa-dev \
        libx11-dev libx11-xcb-dev \
        libxext-dev libxrender-dev \
        libxi-dev libxtst-dev \
        libxkbcommon-dev libxkbcommon-x11-dev \
        libdbus-1-dev \
        libfontconfig1-dev libfreetype6-dev \
        libglib2.0-dev \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-render-util0 \
        libxcb-randr0 \
        libxcb-shape0 \
        libxcb-xfixes0 \
        libxcb-sync1 \
        libxcb-xinerama0 \
        libxcb-util1 \
 && rm -rf /var/lib/apt/lists/*

# ── Step 2: install Python 3.11 standalone (avoids PPA reliability issues) ───
# python-build-standalone provides a pre-built Python 3.11 that works on any
# x86_64 Linux with GLIBC >= 2.17. No compilation needed.
RUN wget -q \
      "https://github.com/indygreg/python-build-standalone/releases/download/20241016/cpython-3.11.10+20241016-x86_64-unknown-linux-gnu-install_only.tar.gz" \
      -O /tmp/python311.tar.gz \
 && tar -xzf /tmp/python311.tar.gz -C /opt \
 && rm /tmp/python311.tar.gz \
 && ln -sf /opt/python/bin/python3.11 /usr/local/bin/python3.11 \
 && ln -sf /opt/python/bin/python3.11 /usr/local/bin/python3 \
 && ln -sf /opt/python/bin/pip3        /usr/local/bin/pip3

ENV PATH=/opt/python/bin:$PATH
# ── Use GCC 10 as default (full C++17 support) ───────────────────────────────
RUN update-alternatives --install /usr/bin/gcc  gcc  /usr/bin/gcc-10  100 \
 && update-alternatives --install /usr/bin/g++  g++  /usr/bin/g++-10  100 \
 && update-alternatives --install /usr/bin/cc   cc   /usr/bin/gcc-10  100 \
 && update-alternatives --install /usr/bin/c++  c++  /usr/bin/g++-10  100

# ── CMake 3.28 (Ubuntu 20.04 ships 3.16 – too old for Qt6) ─────────────────
RUN pip3 install --quiet cmake==3.28.4

# ── Qt 6.9.3 via aqtinstall ────────────────────────────────────
RUN pip3 install --quiet aqtinstall
# Download only the archives needed for a QtWidgets/QtConcurrent app.
# This avoids downloading large optional packages (qml, webkit, wayland, etc.)
# and reduces total download from ~1.5GB to ~200MB.
# Retry up to 5 times to handle CDN timeouts.
RUN for i in 1 2 3 4 5; do \
      aqt install-qt linux desktop 6.9.3 linux_gcc_64 \
          --outputdir /opt/Qt \
          --archives qtbase qttools icu \
      && break || { echo "Attempt $i failed, retrying in 15s..."; sleep 15; }; \
    done

ENV Qt6_DIR=/opt/Qt/6.9.3/gcc_64
ENV PATH=/opt/Qt/6.9.3/gcc_64/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/Qt/6.9.3/gcc_64/lib

# ── linuxdeploy + Qt plugin (run as AppImages via APPIMAGE_EXTRACT_AND_RUN) ──
RUN wget -q \
      https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
      -O /usr/local/bin/linuxdeploy \
 && chmod +x /usr/local/bin/linuxdeploy \
 && wget -q \
      https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage \
      -O /usr/local/bin/linuxdeploy-plugin-qt \
 && chmod +x /usr/local/bin/linuxdeploy-plugin-qt

# ── Copy source ───────────────────────────────────────────────────────────────
WORKDIR /src
COPY . .

# ── Build (Release) ───────────────────────────────────────────────────────────
RUN cmake -S /src -B /build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH=/opt/Qt/6.9.3/gcc_64 \
 && cmake --build /build -j"$(nproc)"


# ── Package into AppImage ─────────────────────────────────────────────────────
RUN mkdir -p /output \
 && APPIMAGE_EXTRACT_AND_RUN=1 \
    QMAKE=/opt/Qt/6.9.3/gcc_64/bin/qmake \
    linuxdeploy \
        --appdir /tmp/appdir \
        -e /build/ToolLogPro \
        -d /src/deploy/deploy.desktop \
        -i /src/deploy/ToolLogPro.png \
        --plugin qt \
        --output appimage \
 && mv /src/ToolLogPro-*.AppImage /output/ToolLogPro-x86_64.AppImage

# Default command: show the produced file
CMD ["ls", "-lh", "/output/"]
