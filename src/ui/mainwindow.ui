  <property name="styleSheet">
   <string notr="true">/* Dark theme stylesheet */
QMainWindow {
    background-color: #1e1e1e;
    color: #cccccc;
}

QWidget {
    background-color: #1e1e1e;
    color: #cccccc;
}

QLineEdit {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 5px;
    color: #cccccc;
}

QLineEdit:focus {
    border: 1px solid #007acc;
}

QPushButton {
    background-color: #3e3e42;
    border: 1px solid #555555;
    border-radius: 2px;
    padding: 5px 10px;
    color: #cccccc;
}

QPushButton:hover {
    background-color: #505053;
    border: 1px solid #6a6a6f;
}

QPushButton:pressed {
    background-color: #2d2d30;
}

QPushButton:checked {
    background-color: #0e639c;
    border: 1px solid #0e639c;
    color: white;
}

QPushButton#btnResume {
    background-color: #0e639c;
    border: 1px solid #0e639c;
    color: white;
}

QPushButton#btnResume:hover {
    background-color: #1177bb;
    border: 1px solid #1177bb;
}

QPushButton#btnAutoScroll:checked {
    background-color: #0e639c;
    border: 1px solid #0e639c;
}

QComboBox {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 5px;
    color: #cccccc;
}

QComboBox::drop-down {
    border: none;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #cccccc;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #2d2d30;
    color: #cccccc;
    selection-background-color: #0e639c;
    selection-color: white;
    border: 1px solid #3e3e42;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: #2d2d30;
    color: #cccccc;
    padding: 5px;
    min-height: 25px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3e3e42;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #0e639c;
    color: white;
}

QTableView {
    background-color: #1e1e1e;
    alternate-background-color: #2a2a2a;
    gridline-color: #3e3e42;
    color: #cccccc;
    border: none;
}

QTableView::item {
    padding: 4px;
}

QTableView::item:selected {
    background-color: #4a2d7a;
}

QTableView::item:focus {
    background-color: #4a2d7a;
    outline: none;
}

QHeaderView::section {
    background-color: #2d2d30;
    color: #cccccc;
    padding: 6px;
    border: none;
    border-right: 1px solid #3e3e42;
    border-bottom: 1px solid #3e3e42;
}

QRadioButton {
    color: #cccccc;
    spacing: 5px;
}

QRadioButton::indicator {
    width: 13px;
    height: 13px;
}

QRadioButton::indicator::unchecked {
    border: 1px solid #3e3e42;
    border-radius: 7px;
    background-color: #2d2d30;
}

QRadioButton::indicator::checked {
    border: 1px solid #007acc;
    border-radius: 7px;
    background-color: #007acc;
}

QLabel {
    color: #cccccc;
}

QGroupBox {
    border: 1px solid #3e3e42;
    border-radius: 3px;
    margin-top: 10px;
    padding-top: 10px;
    color: #cccccc;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
}

QSplitter::handle {
    background-color: #3e3e42;
}

QScrollBar:vertical {
    border: none;
    background-color: #1e1e1e;
    width: 12px;
}

QScrollBar::handle:vertical {
    background-color: #3e3e42;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4e4e52;
}

QScrollBar:horizontal {
    border: none;
    background-color: #1e1e1e;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background-color: #3e3e42;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4e4e52;
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}

QTabWidget::pane {
    border: 1px solid #3e3e42;
    background-color: #1e1e1e;
}

QTabWidget::tab-bar {
    left: 0px;
}

QTabBar::tab {
    background-color: #2d2d30;
    color: #cccccc;
    border: 1px solid #3e3e42;
    padding: 8px 12px;
    margin: 1px;
}

QTabBar::tab:selected {
    background-color: #0e639c;
    color: white;
}

QTabBar::tab:hover:!selected {
    background-color: #3e3e42;
}

/* Vertical tabs (West position) specific styling */
QTabBar::tab:left {
    min-width: 120px;
    min-height: 40px;
    margin-right: 2px;
    padding: 10px 15px;
}

/* Log level label colors */
QRadioButton#radioVerbosePlus, QRadioButton#radioV { color: #aaaaaa; }
QRadioButton#radioD { color: #5c9bd6; }
QRadioButton#radioI { color: #4caa4c; }
QRadioButton#radioW { color: #d4a017; }
QRadioButton#radioE { color: #cc3300; }
QRadioButton#radioA { color: #990033; }
QRadioButton#radioVerbosePlus::indicator:checked,
QRadioButton#radioV::indicator:checked { background-color: #808080; border-color: #808080; }
QRadioButton#radioD::indicator:checked { background-color: #5c9bd6; border-color: #5c9bd6; }
QRadioButton#radioI::indicator:checked { background-color: #4caa4c; border-color: #4caa4c; }
QRadioButton#radioW::indicator:checked { background-color: #d4a017; border-color: #d4a017; }
QRadioButton#radioE::indicator:checked { background-color: #cc3300; border-color: #cc3300; }
QRadioButton#radioA::indicator:checked { background-color: #990033; border-color: #990033; }

QStatusBar {
    background-color: #007acc;
    color: white;
}
            </string>
