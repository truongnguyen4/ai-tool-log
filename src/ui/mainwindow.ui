  <property name="styleSheet">
   <string notr="true">/* ── Dark theme — modern developer focus ─────────── */

/* Base */
QMainWindow, QDialog { background-color: #1e1e1e; color: #cccccc; }
QWidget { background-color: #1e1e1e; color: #cccccc; }

/* Line Edit */
QLineEdit {
    background-color: #3c3c3c;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 8px;
    color: #cccccc;
    selection-background-color: #1a3a80;
}
QLineEdit:hover    { border-color: #5a5a5f; }
QLineEdit:focus    { border-color: #007acc; background-color: #3c3c3c; }
QLineEdit:disabled { color: #6b6b6b; background-color: #2d2d30; border-color: #3e3e42; }

/* Push Button */
QPushButton {
    background-color: #3a3a3a;
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 5px 12px;
    color: #cccccc;
}
QPushButton:hover    { background-color: #454545; border-color: #5a5a5f; }
QPushButton:pressed  { background-color: #2a2a2a; border-color: #007acc; }
QPushButton:disabled { color: #6b6b6b; background-color: #2d2d30; border-color: #3e3e42; }

QPushButton:checked       { background-color: #0e639c; border-color: #0e639c; color: white; }
QPushButton:checked:hover { background-color: #1177bb; border-color: #1177bb; }

QPushButton#btnResume       { background-color: #0e639c; border-color: #0e639c; color: white; }
QPushButton#btnResume:hover { background-color: #1177bb; border-color: #1177bb; }
QPushButton#btnAutoScroll:checked { background-color: #0e639c; border-color: #0e639c; }

/* ComboBox */
QComboBox {
    background-color: #3c3c3c;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 8px;
    color: #cccccc;
}
QComboBox:hover { border-color: #5a5a5f; }
QComboBox:focus { border-color: #007acc; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9d9d9d;
    width: 0;
    height: 0;
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #cccccc;
    selection-background-color: #094771;
    selection-color: white;
    border: 1px solid #454545;
    outline: none;
}
QComboBox QAbstractItemView::item {
    background-color: #252526;
    color: #cccccc;
    padding: 5px 8px;
    min-height: 22px;
}
QComboBox QAbstractItemView::item:hover    { background-color: #2a2d2e; }
QComboBox QAbstractItemView::item:selected { background-color: #094771; color: white; }

/* Table View */
QTableView {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    gridline-color: #2a2a2a;
    color: #cccccc;
    border: none;
    selection-background-color: #1a3a80;
}
QTableView::item              { padding: 3px 6px; border: none; }
QTableView::item:selected     { background-color: #1a3a80; color: #ffffff; }
QTableView::item:focus        { background-color: #1a3a80; outline: none; }
QTableView::item:hover:!selected { background-color: #2a2d2e; }

QHeaderView { background-color: #252526; }
QHeaderView::section {
    background-color: #252526;
    color: #8a8a8a;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #3e3e42;
    border-bottom: 1px solid #3e3e42;
}

/* RadioButton */
QRadioButton { color: #cccccc; spacing: 6px; }
QRadioButton::indicator { width: 14px; height: 14px; }
QRadioButton::indicator:unchecked {
    border: 1px solid #5a5a5f;
    border-radius: 7px;
    background-color: transparent;
}
QRadioButton::indicator:unchecked:hover { border-color: #007acc; }
QRadioButton::indicator:checked {
    border: 1px solid #007acc;
    border-radius: 7px;
    background-color: #007acc;
}

/* CheckBox */
QCheckBox { color: #cccccc; spacing: 6px; }
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #5a5a5f;
    border-radius: 3px;
    background-color: transparent;
}
QCheckBox::indicator:hover           { border-color: #007acc; }
QCheckBox::indicator:checked         { background-color: #007acc; border-color: #007acc; }
QCheckBox::indicator:checked:hover   { background-color: #1177bb; border-color: #1177bb; }

/* Label */
QLabel { color: #cccccc; background: transparent; }

/* Group Box */
QGroupBox {
    border: 1px solid #2d2d30;
    border-radius: 4px;
    margin-top: 12px;
    padding: 8px 8px 6px 8px;
    color: #cccccc;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 5px;
    color: #8a8a8a;
}

/* Splitter */
QSplitter::handle            { background-color: #2d2d30; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical   { height: 3px; }
QSplitter::handle:hover      { background-color: #007acc; }

/* Scroll Bars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 10px;
}
QScrollBar::handle:vertical {
    background-color: #424242;
    border-radius: 5px;
    min-height: 24px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover   { background-color: #686868; }
QScrollBar::handle:vertical:pressed { background-color: #9d9d9d; }

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background-color: #424242;
    border-radius: 5px;
    min-width: 24px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover { background-color: #686868; }

QScrollBar::add-line, QScrollBar::sub-line { border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* Tab Widget */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #3e3e42;
    background-color: #1e1e1e;
}
QTabWidget::tab-bar { left: 0; }

QTabBar { background-color: #252526; }
QTabBar::tab {
    background-color: transparent;
    color: #9d9d9d;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
}
QTabBar::tab:hover:!selected { color: #cccccc; background-color: #2a2d2e; }
QTabBar::tab:selected        { color: #cccccc; border-bottom: 2px solid #007acc; }

QTabBar::tab:left {
    min-width: 110px;
    min-height: 38px;
    border-bottom: none;
    border-right: 2px solid transparent;
    padding: 10px 14px;
}
QTabBar::tab:left:selected        { border-right: 2px solid #007acc; border-bottom: none; }
QTabBar::tab:left:hover:!selected { background-color: #2a2d2e; }

/* Plain / Text Edit (output panels, cell content) */
QPlainTextEdit, QTextEdit {
    background-color: #1e1e1e;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    color: #d4d4d4;
    selection-background-color: #1a3a80;
    padding: 2px;
}
QPlainTextEdit:focus, QTextEdit:focus { border-color: #007acc; }

/* Status Bar */
QStatusBar {
    background-color: #007acc;
    color: white;
    border-top: 1px solid #005a9e;
}
QStatusBar::item { border: none; }

/* Tooltips */
QToolTip {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #454545;
    border-radius: 4px;
    padding: 4px 8px;
}

/* Log level radio colors — VS Code syntax palette */
QRadioButton#radioVerbosePlus, QRadioButton#radioV { color: #9d9d9d; }
QRadioButton#radioD { color: #569cd6; }
QRadioButton#radioI { color: #4ec9b0; }
QRadioButton#radioW { color: #ce9178; }
QRadioButton#radioE { color: #f14c4c; }
QRadioButton#radioA { color: #c586c0; }

QRadioButton#radioVerbosePlus::indicator:checked,
QRadioButton#radioV::indicator:checked { background-color: #9d9d9d; border-color: #9d9d9d; }
QRadioButton#radioD::indicator:checked { background-color: #569cd6; border-color: #569cd6; }
QRadioButton#radioI::indicator:checked { background-color: #4ec9b0; border-color: #4ec9b0; }
QRadioButton#radioW::indicator:checked { background-color: #ce9178; border-color: #ce9178; }
QRadioButton#radioE::indicator:checked { background-color: #f14c4c; border-color: #f14c4c; }
QRadioButton#radioA::indicator:checked { background-color: #c586c0; border-color: #c586c0; }
            </string>
