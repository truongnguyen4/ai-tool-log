       <widget class="QWidget" name="tabDevices">
        <property name="styleSheet">
         <string notr="true">
#tabDevices { background-color: #1e1e1e; }
#devSidebar { background-color: #252526; border-right: 1px solid #3e3e42; }
#devRightPanel { background-color: #1e1e1e; }
QSplitter#devSplitter::handle { background-color: #3e3e42; width: 1px; }
#devLblAppName { color: #007acc; font-weight: bold; letter-spacing: 2px; }
#devLblAppVersion { color: #8a8a8a; letter-spacing: 1px; }
QPushButton#devBtnAddGroup { background-color: transparent; color: #007acc; border: 1px dashed #007acc; border-radius: 4px; padding: 4px 8px; }
QPushButton#devBtnAddGroup:hover { background-color: #1a2a3a; }
QScrollArea#devListScrollArea { background: transparent; border: none; }
QScrollArea#devListScrollArea QScrollBar:vertical { width: 6px; background: transparent; }
QScrollArea#devListScrollArea QScrollBar::handle:vertical { background: #3e3e42; border-radius: 3px; min-height: 20px; }
QScrollArea#devListScrollArea QScrollBar::add-line:vertical,
QScrollArea#devListScrollArea QScrollBar::sub-line:vertical { height: 0; }
#devListContents { background: transparent; }
#devNameLabel { color: #cccccc; font-weight: bold; }
QTabWidget#devInnerTabWidget::pane { border: none; background: #1e1e1e; }
QTabWidget#devInnerTabWidget QTabBar { background: #252526; }
QTabWidget#devInnerTabWidget QTabBar::tab { background: #252526; color: #8a8a8a; border: none; border-bottom: 2px solid transparent; padding: 10px 20px; }
QTabWidget#devInnerTabWidget QTabBar::tab:selected { color: #cccccc; border-bottom: 2px solid #007acc; }
QTabWidget#devInnerTabWidget QTabBar::tab:hover:!selected { color: #cccccc; }
QScrollArea#devDashScrollArea { background: #1e1e1e; border: none; }
QScrollArea#devDashScrollArea QScrollBar:vertical { width: 8px; background: transparent; border: none; }
QScrollArea#devDashScrollArea QScrollBar::handle:vertical { background: #3e3e42; border-radius: 4px; min-height: 24px; margin: 2px; }
QScrollArea#devDashScrollArea QScrollBar::add-line:vertical,
QScrollArea#devDashScrollArea QScrollBar::sub-line:vertical { height: 0; }
#devDashContents { background-color: #1e1e1e; }
#devInfoSep1, #devInfoSep2, #devInfoSep3 { color: #3e3e42; }
#devBatteryTitle, #devIpTitle, #devNetworkTitle { color: #8a8a8a; letter-spacing: 1px; background: transparent; border: none; }
#devBatteryValue, #devIpValue, #devNetworkValue { color: #cccccc; font-weight: bold; background: transparent; border: none; }
#devBatteryIcon, #devIpIcon, #devNetworkIcon, #devWifiSsidIcon, #devWifiPassIcon { color: #8a8a8a; background: transparent; border: none; }
#devQaTitle, #devSiTitle, #devConfigTitle, #devDeviceListTitle { color: #8a8a8a; font-weight: bold; letter-spacing: 1px; background: transparent; border: none; }
#devWifiSsidTitle, #devWifiPassTitle { color: #8a8a8a; letter-spacing: 1px; background: transparent; border: none; }
#devWifiSsidEdit, #devWifiPassEdit { background-color: #2d2d30; color: #cccccc; border: 1px solid #3e3e42; border-radius: 3px; padding: 4px 8px; }
#devWifiSsidEdit:focus, #devWifiPassEdit:focus { border-color: #007acc; }
#devSiManufacturerKey, #devSiModelKey, #devSiAndroidVersionKey, #devSiSdkVersionKey, #devSiBuildNumberKey, #devSiBuildFingerprintKey, #devSiSecurityPatchKey, #devSiKernelVersionKey, #devSiAbiKey { color: #8a8a8a; letter-spacing: 1px; background: transparent; border: none; border-bottom: 1px solid #3e3e42; padding: 4px 0; }
#devSiManufacturerValue, #devSiModelValue, #devSiAndroidVersionValue, #devSiSdkVersionValue, #devSiBuildNumberValue, #devSiBuildFingerprintValue, #devSiSecurityPatchValue, #devSiKernelVersionValue, #devSiAbiValue { color: #cccccc; background: transparent; border: none; border-bottom: 1px solid #3e3e42; padding: 4px 0; }
QTabWidget#devConfigTabWidget::pane { border: 1px solid #3e3e42; background: #252526; }
QTabWidget#devConfigTabWidget QTabBar { background: #1e1e1e; }
QTabWidget#devConfigTabWidget QTabBar::tab { background: #252526; color: #8a8a8a; border: none; border-bottom: 2px solid transparent; padding: 8px 16px; }
QTabWidget#devConfigTabWidget QTabBar::tab:selected { color: #cccccc; border-bottom: 2px solid #007acc; }
QTabWidget#devConfigTabWidget QTabBar::tab:hover:!selected { color: #cccccc; }
QPushButton#devBtnDeployConfig { background-color: #007acc; color: #ffffff; border: none; border-radius: 4px; padding: 6px 16px; font-weight: bold; }
QPushButton#devBtnDeployConfig:hover { background-color: #1a8ad4; }
QPushButton#devBtnDeployConfig:pressed { background-color: #005a9e; }
QPushButton#devBtnExportJson { background: transparent; border: none; padding: 4px; }
QPushButton#devBtnExportJson:hover { background-color: #3e3e42; border-radius: 4px; }
QPushButton#devBtnImportJson { background: transparent; border: none; padding: 4px; }
QPushButton#devBtnImportJson:hover { background-color: #3e3e42; border-radius: 4px; }
QPushButton#devBtnDeployConfig { background-color: #e67e22; color: #ffffff; border: none; border-radius: 4px; padding: 6px 16px; font-weight: bold; }
QPushButton#devBtnDeployConfig:hover { background-color: #f0932b; }
QPushButton#devBtnDeployConfig:pressed { background-color: #cc6d1a; }
QPushButton#devBtnDeployConfig:disabled { background-color: #2d2d30; color: #5a5a5a; border: 1px solid #3e3e42; }
QPushButton#devBtnSavePreset { background: transparent; border: none; padding: 4px; }
QPushButton#devBtnSavePreset:hover { background-color: #3e3e42; border-radius: 4px; }
QPushButton#devBtnLoadPreset { background: transparent; border: none; padding: 4px; }
QPushButton#devBtnLoadPreset:hover { background-color: #3e3e42; border-radius: 4px; }
QTextEdit#devJsonView { background-color: #1e1e1e; color: #d4d4d4; border: 1px solid #3e3e42; border-radius: 4px; font-family: monospace; }
#devStayAwakeRow, #devAllowMockRow, #devVerifyAdbRow, #devLocaleRow, #devTimeFormatRow { background: #2d2d30; border: 1px solid #3e3e42; border-radius: 6px; }
#devStayAwakeIcon, #devAllowMockIcon, #devVerifyAdbIcon, #devLocaleIcon, #devTimeFormatIcon { color: #cccccc; background: transparent; border: none; }
#devStayAwakeLabel, #devAllowMockLabel, #devVerifyAdbLabel, #devLocaleLabel, #devTimeFormatLabel { color: #cccccc; font-weight: bold; background: transparent; border: none; }
#devStayAwakeDesc, #devAllowMockDesc, #devVerifyAdbDesc, #devLocaleDesc, #devTimeFormatDesc { color: #8a8a8a; background: transparent; border: none; }
#devLocaleEdit { background-color: #2d2d30; color: #cccccc; border: 1px solid #3e3e42; border-radius: 3px; padding: 4px 8px; }
#devLocaleEdit:focus { border-color: #007acc; }
#devFirmwareIcon, #devFirmwareTitle { color: #cccccc; background: transparent; border: none; font-weight: bold; }
#devFirmwarePathEdit { background-color: #2d2d30; color: #cccccc; border: 1px solid #3e3e42; border-radius: 3px; padding: 4px 8px; }
QPushButton#devBtnBrowseFirmware { background-color: #37373d; color: #cccccc; border: 1px solid #3e3e42; border-radius: 4px; padding: 4px 8px; }
QPushButton#devBtnBrowseFirmware:hover { background-color: #3e3e50; border-color: #007acc; }
QPushButton#devBtnFlash { background-color: #d4760a; color: #ffffff; border: none; border-radius: 4px; padding: 10px 8px; font-weight: bold; }
QPushButton#devBtnFlash:hover { background-color: #e88a1e; }
QPushButton#devBtnFlash:pressed { background-color: #b5650a; }
QPushButton#devBtnFlash:disabled { background-color: #2d2d30; color: #5a5a5a; border: 1px solid #3e3e42; }
QPushButton#devBtnConnectWifi { background-color: #d4760a; color: #ffffff; border: none; border-radius: 4px; padding: 10px 8px; font-weight: bold; }
QPushButton#devBtnConnectWifi:hover { background-color: #e88a1e; }
QPushButton#devBtnConnectWifi:pressed { background-color: #b5650a; }
QPushButton#devBtnConnectWifi:disabled { background-color: #2d2d30; color: #5a5a5a; border: 1px solid #3e3e42; }
QPushButton#devBtnReboot, QPushButton#devBtnSyslog, QPushButton#devBtnClearCache,
QPushButton#devBtnUnlock, QPushButton#devBtnForceStop, QPushButton#devBtnAdbWireless,
QPushButton#devBtnAdbRoot, QPushButton#devBtnAdbUnroot, QPushButton#devBtnRebootFastboot,
QPushButton#devBtnPowerKey {
  background-color: #1a6fb5; color: #ffffff; border: none;
  border-radius: 4px; padding: 10px 8px; font-weight: bold;
}
QPushButton#devBtnReboot:hover, QPushButton#devBtnSyslog:hover,
QPushButton#devBtnClearCache:hover, QPushButton#devBtnUnlock:hover,
QPushButton#devBtnForceStop:hover, QPushButton#devBtnAdbWireless:hover,
QPushButton#devBtnAdbRoot:hover, QPushButton#devBtnAdbUnroot:hover,
QPushButton#devBtnRebootFastboot:hover,
QPushButton#devBtnPowerKey:hover { background-color: #2080cc; }
QPushButton#devBtnReboot:pressed, QPushButton#devBtnSyslog:pressed,
QPushButton#devBtnClearCache:pressed, QPushButton#devBtnUnlock:pressed,
QPushButton#devBtnForceStop:pressed, QPushButton#devBtnAdbWireless:pressed,
QPushButton#devBtnAdbRoot:pressed, QPushButton#devBtnAdbUnroot:pressed,
QPushButton#devBtnRebootFastboot:pressed,
QPushButton#devBtnPowerKey:pressed { background-color: #145a96; }
QPushButton#devBtnReboot:disabled, QPushButton#devBtnSyslog:disabled,
QPushButton#devBtnClearCache:disabled, QPushButton#devBtnUnlock:disabled,
QPushButton#devBtnForceStop:disabled, QPushButton#devBtnAdbWireless:disabled,
QPushButton#devBtnAdbRoot:disabled, QPushButton#devBtnAdbUnroot:disabled,
QPushButton#devBtnRebootFastboot:disabled,
QPushButton#devBtnPowerKey:disabled { background-color: #2d2d30; color: #5a5a5a; border: 1px solid #3e3e42; }
